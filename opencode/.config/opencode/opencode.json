{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": 15536,
    "keep": {
      "tokens": 8192
    }
  },
  "subagent_depth": 3,
  "lsp": true,
  "mcp": {
    "authentik": {
      "command": [
        "uvx",
        "--from",
        "authentik-mcp",
        "--with",
        "mcp<2.0",
        "authentik-mcp",
        "--base-url",
        "https://authentik.labb.site",
        "--token",
        "{env:MCP_TOKEN}"
      ],
      "type": "local"
    },
    "grafana": {
      "command": [
        "uvx",
        "mcp-grafana",
        "-t",
        "stdio"
      ],
      "env": {
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:MCP_TOKEN}",
        "GRAFANA_URL": "https://grafana.labb.site"
      },
      "type": "local"
    },
    "kubernetes": {
      "enabled": true,
      "headers": {
        "Authorization": "{env:K8S_TOKEN}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.labb.site/k8s/mcp"
    },
    "flux-schema-catalog": {
      "enabled": true,
      "type": "remote",
      "url": "https://schemas.fluxoperator.dev/mcp"
    }
  },
  "permission": {
    "external_directory": {
      "~/workspace/personal/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "ask",
      "awk*": "allow",
      "basename*": "allow",
      "cat*": "allow",
      "cut*": "allow",
      "date*": "allow",
      "df*": "allow",
      "diff*": "allow",
      "dirname*": "allow",
      "du*": "allow",
      "echo*": "allow",
      "env*": "allow",
      "file*": "allow",
      "find*": "allow",
      "flux*": "ask",
      "flux-local*": "allow",
      "gh*": "allow",
      "git*": "allow",
      "grep*": "allow",
      "head*": "allow",
      "helm*": "ask",
      "hostname*": "allow",
      "id*": "allow",
      "jq*": "allow",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl drain*": "ask",
      "kubectl edit*": "ask",
      "kubectl patch*": "ask",
      "kubectl*": "allow",
      "la*": "allow",
      "ll*": "allow",
      "ls*": "allow",
      "pnpm*": "allow",
      "printenv*": "allow",
      "printf*": "allow",
      "ps*": "allow",
      "pwd*": "allow",
      "readlink*": "allow",
      "realpath*": "allow",
      "rg*": "allow",
      "sed*": "allow",
      "sort*": "allow",
      "source .venv/bin/activate": "allow",
      "stat*": "allow",
      "tail*": "allow",
      "tr*": "allow",
      "tree*": "allow",
      "turbo*": "allow",
      "type*": "allow",
      "uname*": "allow",
      "uniq*": "allow",
      "wc*": "allow",
      "which*": "allow",
      "whoami*": "allow",
      "xargs*": "allow",
      "act*": "allow",
      "mkdir*": "allow",
      "*eslint*": "allow",
      "*python*": "allow",
      "uv*": "allow",
      "uuidgen*": "allow",
      "pgrep*": "allow",
      "sleep*": "allow",
      "graft*": "allow",
      "flate*": "allow",
      "alembic*": "allow",
      "ruff*": "allow",
      "docker*": "allow"
    },
    "doom_loop": "ask",
    "edit": "allow",
    "read": "allow",
    "webfetch": "allow",
    "write": "ask"
  },
  "plugin": [
    "opentmux@latest",
    "opencode-plugin-litellm@latest",
    "{env:HOME}/.hindsight/coding-agents"
  ],
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:LITELLM_API_KEY}",
        "baseURL": "https://litellm.labb.site/v1"
      }
    },
    "local lmstudio": {
      "models": {
        "diffusiongemma-26b-a4b-it": {
          "name": "diffusiongemma-26b-a4b-it"
        },
        "gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2": {
          "name": "gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2"
        },
        "gemma-4-31b-it": {
          "name": "gemma-4-31b-it"
        },
        "glm-4.7-flash-reap-23b-a3b": {
          "name": "glm-4.7-flash-reap-23b-a3b"
        },
        "google/gemma-4-26b-a4b-qat": {
          "name": "google/gemma-4-26b-a4b-qat",
          "settings": {
            "reasoningEffort": "on"
          },
          "variants": {
            "off": {
              "settings": {
                "reasoningEffort": "off",
                "extraBody": {
                  "enable_thinking": false,
                  "reasoning_budget": 0
                }
              }
            },
            "on": {
              "settings": {
                "reasoningEffort": "on",
                "extraBody": {
                  "enable_thinking": true,
                  "reasoning_budget": -1
                }
              }
            }
          }
        },
        "ornith-1.0-35b": {
          "name": "ornith-1.0-35b"
        },
        "ornith-1.0-35b-mlx": {
          "name": "ornith-1.0-35b-mlx"
        },
        "qwable-3.6-35b": {
          "name": "qwable-3.6-35b"
        },
        "qwen/qwen2.5-coder-14b": {
          "name": "qwen/qwen2.5-coder-14b"
        },
        "qwopus3.6-35b-a3b-v1-mlx-mixed_4_6": {
          "name": "qwopus3.6-35b-a3b-v1-mlx-mixed_4_6",
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "extraBody": {
                "reasoning_budget": 0
              }
            },
            "minimal": {
              "reasoningEffort": "minimal",
              "extraBody": {
                "reasoning_budget": 512
              }
            },
            "low": {
              "reasoningEffort": "low",
              "extraBody": {
                "reasoning_budget": 1024
              }
            },
            "medium": {
              "reasoningEffort": "medium",
              "extraBody": {
                "reasoning_budget": 4096
              }
            },
            "high": {
              "reasoningEffort": "high",
              "extraBody": {
                "reasoning_budget": -1
              }
            },
            "max": {
              "reasoningEffort": "xhigh",
              "extraBody": {
                "reasoning_budget": -1
              }
            }
          }
        },
        "qwen3.6-14b-a3b-fablevibes": {
          "name": "qwen3.6-14b-a3b-fablevibes"
        },
        "qwen/qwen3.8-27b": {
          "name": "qwen3.8-27B",
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "extraBody": {
                "reasoning_budget": 0
              }
            },
            "minimal": {
              "reasoningEffort": "minimal",
              "extraBody": {
                "reasoning_budget": 512
              }
            },
            "low": {
              "reasoningEffort": "low",
              "extraBody": {
                "reasoning_budget": 1024
              }
            },
            "medium": {
              "reasoningEffort": "medium",
              "extraBody": {
                "reasoning_budget": 4096
              }
            },
            "high": {
              "reasoningEffort": "high",
              "extraBody": {
                "reasoning_budget": -1
              }
            },
            "max": {
              "reasoningEffort": "xhigh",
              "extraBody": {
                "reasoning_budget": -1
              }
            }
          }
        }
      },
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "not-needed",
        "baseURL": "http://localhost:1234/v1"
      }
    }
  },
  "model": "google/gemma-4-26b-a4b-qat",
  "small_model": "qwen/qwen2.5-coder-14b",
  "default_agent": "team-lead"
}
