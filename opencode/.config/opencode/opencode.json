{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "buffer": 15536,
    "keep": {
      "tokens": 8192
    }
  },
  "subagent_depth": 2,
  "lsp": true,
  "mcp": {  
  },
  "permission": {
    "external_directory": {
      "~/workspace/personal/**": "allow",
      "~/.config/opencode/**": "allow",
      "/tmp/**": "allow"
    },
    "bash": {
      "*": "ask",
      "cp*": "allow",
      "chmod*": "allow",
      "chown*": "allow",
      "mv*": "allow",
      "rm*": "allow",
      "mkdir*": "allow",
      "stow*": "allow",
      "sops*": "allow",
      "age*": "allow",
      "set*": "allow",
      "export*": "allow",
      "source*": "allow",
      "zsh -n*": "allow",
      "bash -n*": "allow",
      "yaml*": "allow",
      "cmp*": "allow",
      "awk*": "allow",
      "basename*": "allow",
      "cat*": "allow",
      "cut*": "allow",
      "date*": "allow",
      "df*": "allow",
      "diff*": "allow",
      "dirname*": "allow",
      "du*": "allow",
      "echo*": "allow",
      "env*": "allow",
      "file*": "allow",
      "find*": "allow",
      "flux*": "ask",
      "flux-local*": "allow",
      "gh*": "allow",
      "git*": "allow",
      "grep*": "allow",
      "head*": "allow",
      "helm*": "ask",
      "hostname*": "allow",
      "id*": "allow",
      "jq*": "allow",
      "kubectl apply*": "ask",
      "kubectl delete*": "ask",
      "kubectl drain*": "ask",
      "kubectl edit*": "ask",
      "kubectl patch*": "ask",
      "kubectl*": "allow",
      "la*": "allow",
      "ll*": "allow",
      "ls*": "allow",
      "pnpm*": "allow",
      "printenv*": "allow",
      "printf*": "allow",
      "ps*": "allow",
      "pwd*": "allow",
      "readlink*": "allow",
      "realpath*": "allow",
      "rg*": "allow",
      "sed*": "allow",
      "sort*": "allow",
      "source .venv/bin/activate": "allow",
      "stat*": "allow",
      "tail*": "allow",
      "tr*": "allow",
      "tree*": "allow",
      "turbo*": "allow",
      "type*": "allow",
      "uname*": "allow",
      "uniq*": "allow",
      "wc*": "allow",
      "which*": "allow",
      "whoami*": "allow",
      "xargs*": "allow",
      "act*": "allow",
      "*eslint*": "allow",
      "*python*": "allow",
      "uv*": "allow",
      "uuidgen*": "allow",
      "pgrep*": "allow",
      "sleep*": "allow",
      "graft*": "allow",
      "flate*": "allow",
      "alembic*": "allow",
      "ruff*": "allow",
      "rtk*": "allow",
      "docker*": "allow"
    },
    "doom_loop": "ask",
    "edit": "allow",
    "read": "allow",
    "webfetch": "allow",
    "write": "ask"
  },
  "plugin": [
    "opentmux@latest",
    "opencode-plugin-litellm@latest",
    "/Users/seppa/.hindsight/coding-agents"
  ],
  "provider": {
    "litellm": {
      "name": "LiteLLM",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:LITELLM_API_KEY}",
        "baseURL": "https://litellm.labb.site/v1"
      }
    },
    "local lmstudio": {
      "models": {
        "google/gemma-4-26b-a4b-qat": {
          "name": "google/gemma-4-26b-a4b-qat",
          "settings": {
            "reasoningEffort": "on"
          },
          "variants": {
            "off": {
              "settings": {
                "reasoningEffort": "off",
                "extraBody": {
                  "enable_thinking": false,
                  "reasoning_budget": 0
                }
              }
            },
            "on": {
              "settings": {
                "reasoningEffort": "on",
                "extraBody": {
                  "enable_thinking": true,
                  "reasoning_budget": -1
                }
              }
            }
          }
        },
        "qwen3.8-27b-gsq-rco": {
          "name": "qwen3.8-27b-gsq-rco",
          "limit": {
            "context": 80000,
            "output": 16000
          }
        },
        "qwen3.8-27b-twin-turbo-fable-cold-fusion-709-l-uncensored-gsq-rco-mtp": {
          "name": "qwen3.8-27b-twin-turbo-fable-cold-fusion-709-l-uncensored-gsq-rco-mtp",
          "limit": {
            "context": 95126,
            "output": 16000
          }
        },
        "prism-ml/bonsai-27b": {
          "name": "prism-ml/bonsai-27b"
        },
        "qwen3.8-27b-qat-nvfp4": {
          "name": "qwen3.8-27b-qat-nvfp4"
        },
        "thinkingcap-qwen3.6-27b": {
          "name": "thinkingcap-qwen3.6-27b"
        },
        "qwen/qwen2.5-coder-14b": {
          "name": "qwen/qwen2.5-coder-14b"
        },
        "qwen/qwen3.8-27b": {
          "name": "qwen3.8-27B",
          "settings": {
            "reasoningEffort": "medium"
          },
          "variants": {
            "none": {
              "reasoningEffort": "none",
              "extraBody": {
                "reasoning_budget": 0
              }
            },
            "minimal": {
              "reasoningEffort": "minimal",
              "extraBody": {
                "reasoning_budget": 512
              }
            },
            "low": {
              "reasoningEffort": "low",
              "extraBody": {
                "reasoning_budget": 1024
              }
            },
            "medium": {
              "reasoningEffort": "medium",
              "extraBody": {
                "reasoning_budget": 4096
              }
            },
            "high": {
              "reasoningEffort": "high",
              "extraBody": {
                "reasoning_budget": -1
              }
            },
            "max": {
              "reasoningEffort": "xhigh",
              "extraBody": {
                "reasoning_budget": -1
              }
            }
          }
        }
      },
      "name": "LM Studio",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "not-needed",
        "baseURL": "http://localhost:1234/v1"
      }
    }
  },
  "model": "local lmstudio/google/gemma-4-26b-a4b-qat",
  "small_model": "local lmstudio/qwen/qwen2.5-coder-14b",
  "default_agent": "team-lead"
}
