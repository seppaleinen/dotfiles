{
  "$schema" : "https:\/\/opencode.ai\/config.json",
  "compaction" : {
    "auto" : true,
    "prune" : true
  },
  "lsp" : true,
  "mcp" : {
    "authentik" : {
      "command" : [
        "uvx",
        "--from",
        "authentik-mcp",
        "--with",
        "mcp<2.0",
        "authentik-mcp",
        "--base-url",
        "https:\/\/authentik.labb.site",
        "--token",
        "{env:MCP_TOKEN}"
      ],
      "type" : "local"
    },
    "grafana" : {
      "command" : [
        "uvx",
        "mcp-grafana",
        "-t",
        "stdio"
      ],
      "env" : {
        "GRAFANA_SERVICE_ACCOUNT_TOKEN" : "{env:MCP_TOKEN}",
        "GRAFANA_URL" : "https:\/\/grafana.labb.site"
      },
      "type" : "local"
    },
"kubernetes" : {
      "enabled" : true,
      "headers" : {
        "Authorization" : "{env:K8S_TOKEN}"
      },
      "oauth" : false,
      "type" : "remote",
      "url" : "https:\/\/mcp.labb.site\/k8s\/mcp"
    }
  },
  "mode" : {

  },
  "permission" : {
    "bash" : {
      "*" : "ask",
      "awk*" : "allow",
      "basename*" : "allow",
      "cat*" : "allow",
      "cut*" : "allow",
      "date*" : "allow",
      "df*" : "allow",
      "diff*" : "allow",
      "dirname*" : "allow",
      "du*" : "allow",
      "echo*" : "allow",
      "env*" : "allow",
      "file*" : "allow",
      "find*" : "allow",
      "flux*" : "ask",
      "flux-local*" : "allow",
      "gh*" : "allow",
      "git*" : "allow",
      "grep*" : "allow",
      "head*" : "allow",
      "helm*" : "ask",
      "hostname*" : "allow",
      "id*" : "allow",
      "jq*" : "allow",
      "kubectl apply*" : "ask",
      "kubectl delete*" : "ask",
      "kubectl drain*" : "ask",
      "kubectl edit*" : "ask",
      "kubectl patch*" : "ask",
      "kubectl*" : "allow",
      "la*" : "allow",
      "ll*" : "allow",
      "ls*" : "allow",
      "pnpm*" : "allow",
      "printenv*" : "allow",
      "printf*" : "allow",
      "ps*" : "allow",
      "pwd*" : "allow",
      "readlink*" : "allow",
      "realpath*" : "allow",
      "rg*" : "allow",
      "sed*" : "allow",
      "sort*" : "allow",
      "source .venv\/bin\/activate" : "allow",
      "stat*" : "allow",
      "tail*" : "allow",
      "tr*" : "allow",
      "tree*" : "allow",
      "turbo*" : "allow",
      "type*" : "allow",
      "uname*" : "allow",
      "uniq*" : "allow",
      "wc*" : "allow",
      "which*" : "allow",
      "whoami*" : "allow",
      "xargs*" : "allow",
      "act*" : "allow",
      "which*" : "allow",
      "mkdir*" : "allow",
      "*eslint*" : "allow",
      "*python*" : "allow",
      "uv*" : "allow",
      "uuidgen*": "allow",
      "pgrep*": "allow",
      "act*": "allow",
      "sleep*": "allow",
      "docker*" : "allow"
    },
    "doom_loop" : "ask",
    "edit" : "allow",
    "read" : "allow",
    "webfetch" : "allow",
    "write" : "ask"
  },
  "plugin" : [
    "opencode-agent-tmux",
    ["@vectorize-io/opencode-hindsight", {
      "hindsightApiUrl": "https://hindsight.labb.site/v1/default",
      "dynamicBankId": true,
      "dynamicBankGranularity": ["project"],
      "autoRecall": true,
      "autoRetain": true
    }]
  ],
  "provider" : {
    "litellm" : {
      "models" : {
        "qwen3.6-35b-a3b-mtp" : {
